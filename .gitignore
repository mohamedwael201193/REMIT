# ---- secrets: NEVER commit ----
.env
.env.*
!.env.example
*.seed
*.mnemonic
*.key
*.pem
secrets/
wallet-state/
.midnight/

# ---- build / deps ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.vite/

# ---- compiled compact artifacts ----
# ZKIR + verifier keys are small and hosted by the API. Prover keys are too large for git;
# Render/Docker fetch them at build (scripts/fetch-prover-keys.mjs).
CONTRACT/managed/**/keys/*.prover
browser-provers.tar.gz
RESEARCH/spikes/**/managed/

# ---- runtime state ----
logs/
*.log
private-state/
leveldb/
*.sqlite
*.db

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- research spike build outputs (110 MB of prover keys) ----
RESEARCH/spikes/**/out/
RESEARCH/spikes/**/out-*/

# ---- planning/research markdown stays local; GitHub gets README.md only ----
*.md
!README.md

# ---- local deploy evidence / wallet snapshots ----
deployments/
.midnight/
wallet-cache/
dist/browser/
*.generated.env
agent-keys.generated.env

# ---- supplied frontend: track source, never secrets / nested git / deps ----
front/.git/
front/.git.nested/
front/node_modules/
front/.next/
front/.env
front/.env.*
!front/.env.example
front/*.log
front/.zscripts/
front/download/
