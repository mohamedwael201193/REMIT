# REMIT — environment template. Copy to `.env.preprod.local` (gitignored) and fill in.
# RULES:
#   * Anything secret lives ONLY in .env.*.local files, which are gitignored.
#   * Never put a secret into a VITE_* / NEXT_PUBLIC_* variable — those are bundled into the browser.
#   * Never echo these values in logs, READMEs, screenshots or EXECUTION_HISTORY.md.

# ---------- network (public, safe to commit as defaults) ----------
MIDNIGHT_NETWORK=preprod                      # undeployed | preview | preprod | mainnet
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_NODE_WS=wss://rpc.preprod.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300   # always local (docker midnightntwrk/proof-server:8.1.0)
MIDNIGHT_FAUCET_URL=https://midnight-tmnight-preprod.nethermind.dev/

# ---------- pinned toolchain (from the official compatibility matrix, Preprod, 2026-09-13) ----------
COMPACT_TOOLCHAIN_VERSION=0.31.1
COMPACT_LANGUAGE_VERSION=0.23
MIDNIGHT_JS_VERSION=4.1.1
WALLET_SDK_VERSION=1.2.0
DAPP_CONNECTOR_API_VERSION=4.0.1
PROOF_SERVER_IMAGE=midnightntwrk/proof-server:8.1.0
INDEXER_IMAGE=midnightntwrk/indexer-standalone:4.3.3
NODE_IMAGE=midnightntwrk/midnight-node:1.0.2

# ---------- deployed contract (public once deployed) ----------
REMIT_POOL_CONTRACT_ADDRESS=
REMIT_TESTQUOTE_CONTRACT_ADDRESS=
REMIT_DEPLOY_TX_ID=
REMIT_DEPLOY_BLOCK=

# ---------- operator / agent wallet (SECRET — fill only in .env.preprod.local) ----------
# 24-word BIP-39 mnemonic of the DEDICATED TESTNET wallet. Test funds only.
REMIT_OPERATOR_MNEMONIC=
# Public addresses of that wallet (not secret, but kept here so scripts can assert they match the mnemonic)
REMIT_OPERATOR_UNSHIELDED_ADDR=
REMIT_OPERATOR_SHIELDED_ADDR=
REMIT_OPERATOR_DUST_ADDR=
REMIT_OPERATOR_CARDANO_ADDR=

# ---------- agent daemon ----------
REMIT_AGENT_STRATEGY=deterministic-best-quote   # deterministic-best-quote | llm-advisor (advisory only; never bypasses the circuit)
REMIT_AGENT_POLL_MS=6000
REMIT_AGENT_PRIVATE_STATE_PASSWORD=             # encrypts the level private-state DB (SECRET)
REMIT_EXECUTOR_SECRET_HEX=                      # 32-byte hex `esk`; executorKey = H("remit:ek", esk). Generated once by `pnpm agent:keygen` (SECRET)
REMIT_AGENT_RFQ_BOX_SECRET_HEX=                 # X25519 secret for the sealed-box RFQ inbox (SECRET)
REMIT_AGENT_FILL_JITTER_MS=15000                # max random delay before submitting a fill (timing-correlation mitigation)

# ---------- api (backend) ----------
REMIT_API_PORT=8787
REMIT_API_CORS_ORIGIN=http://localhost:5173
REMIT_API_ADMIN_TOKEN=                          # protects POST /disclose (SECRET)
REMIT_KEYS_BASE_URL=http://localhost:8787/keys  # where prover/verifier keys are served with CORS for in-browser proving

# ---------- hosting / git (SECRET — fill only in .env.preprod.local) ----------
GITHUB_TOKEN=
RENDER_API_KEY=
VERCEL_TOKEN=
RENDER_SERVICE_ID=
RENDER_SERVICE_URL=https://remit-api-node.onrender.com
# docker twin (same commit): https://remit-api-la96.onrender.com

# ---------- optional integrations ----------
# LLM_API_KEY=                                  # only if REMIT_AGENT_STRATEGY=llm-advisor (SECRET)

# ---------- browser (PUBLIC ONLY — bundled by Vite) ----------
VITE_MIDNIGHT_NETWORK=preprod
VITE_MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_MIDNIGHT_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
VITE_REMIT_POOL_CONTRACT_ADDRESS=
VITE_REMIT_API_URL=http://localhost:8787
